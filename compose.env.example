# Copy to .env.compose. Keep machine-specific paths and secrets out of Git.
BERN_UI_IMAGE=bern-archives-ui:local
BERN_DATA_HOST_DIR=./data/derived/j2-full
BERN_SAVED_RUNS_HOST_DIR=./runs
BERN_ORIGINAL_REVIEWS_HOST_DIR=./runs/review-exports
BERN_ACCOUNT_REVIEWS_HOST_DIR=./runs/reviewer-exports
BERN_LIVE_PORT=17860
BERN_REVIEW_PORT=17863
# Docker Desktop: host service. Remote service: use its reachable HTTPS /v1 endpoint.
# Native Linux host-loopback service: use compose.host-network.yaml and 127.0.0.1 here.
BERN_DOCKER_MODEL_URL=http://host.docker.internal:8010/v1
# On Linux set these to the numeric owner of the writable account-export directory (id -u / id -g).
BERN_CONTAINER_UID=1000
BERN_CONTAINER_GID=1000
